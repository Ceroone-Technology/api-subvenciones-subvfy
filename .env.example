# Copiar a .env y ajustar. Nunca commitear el .env real.

ENVIRONMENT=development

# Debe coincidir con las credenciales del servicio "db" de docker-compose.yml
DATABASE_URL=postgresql+asyncpg://subvfy:subvfy@localhost:5432/subvfy

JWT_SECRET_KEY=changeme-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:4200
