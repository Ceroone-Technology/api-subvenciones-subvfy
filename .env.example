# Copiar a .env y ajustar. Nunca commitear el .env real.

# development | production. Sin esta variable se aplica production, el estricto.
ENVIRONMENT=development

# Debe coincidir con las credenciales del servicio "db" de docker-compose.yml
DATABASE_URL=postgresql+asyncpg://subvfy:subvfy@localhost:5432/subvfy
# Echo de SQL. OJO: vuelca cada sentencia CON SUS PARÁMETROS (hashes de
# contraseña, emails, tokens) al log. Apagado también en development: ponlo a
# true solo mientras depuras y nunca en un entorno compartido.
DATABASE_ECHO=false

# Obligatoria, mínimo 32 caracteres. Este valor es público (está en el repo):
# solo vale con ENVIRONMENT=development, fuera de ahí la API no arranca con él.
# Para generar uno: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-inseguro-no-usar-fuera-de-desarrollo-0000
# Solo se admite HS256.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Notificaciones por email.
# EMAIL_BACKEND=consola escribe el correo en el log en vez de enviarlo (dev y tests).
# Pon "ses" solo donde haya credenciales de AWS y el dominio verificado.
EMAIL_BACKEND=consola
EMAIL_REMITENTE=alertas@subvfy.es
EMAIL_REMITENTE_NOMBRE=Subvfy
EMAIL_MAX_CONVOCATORIAS=10
AWS_REGION=eu-west-1

# Base de los enlaces del correo hacia el frontend Angular
FRONTEND_BASE_URL=http://localhost:4200
FRONTEND_RUTA_CONVOCATORIA=/convocatorias/{codigo_bdns}
FRONTEND_RUTA_ALERTAS=/alertas

LOG_LEVEL=INFO

# BDNS: API pública, sin credenciales. Solo se ajustan los topes y el timeout.
BDNS_BASE_URL=https://www.infosubvenciones.es/bdnstrans/api
BDNS_TIMEOUT_SEGUNDOS=10
BDNS_TAMANO_PAGINA=100
BDNS_MAX_PAGINAS=20
BDNS_DIAS_PRIMERA_EJECUCION=7

# Motor de alertas. En local, APScheduler dentro del proceso de la API.
# Ponlo a true para verlo trabajar; baja el intervalo para probar a mano.
SCHEDULER_HABILITADO=false
SCHEDULER_INTERVALO_MINUTOS=15

# Espera entre reintentos de una alerta que falla: base x 2^(fallos-1), con tope.
ALERTAS_REINTENTO_BASE_MINUTOS=15
ALERTAS_REINTENTO_MAX_HORAS=24

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:4200
